<aside
    class="admin-sidebar"
    id="adminSidebar"
    aria-label="Menu administrativo"
>

    <div class="admin-sidebar-cabecalho">
        <a
            href="/admin"
            class="admin-sidebar-logo"
            aria-label="Manto 10 - Painel administrativo"
        >
            <img
                src="/images/logotransparente.png"
                alt="Manto 10"
            >
        </a>
    </div>

    <nav class="admin-sidebar-menu">

        <a
            href="/admin"
            class="<%= secaoAdmin === 'dashboard' ? 'ativo' : '' %>"
        >
            <span>Dashboard</span>
        </a>

        <a
            href="/admin/produtos"
            class="<%= secaoAdmin === 'produtos' ? 'ativo' : '' %>"
        >
            <span>Camisas</span>
        </a>

        <a
            href="/admin/usuarios"
            class="<%= secaoAdmin === 'usuarios' ? 'ativo' : '' %>"
        >
            <span>Usuários</span>
        </a>

        <a
            href="/admin/pedidos"
            class="<%= secaoAdmin === 'pedidos' ? 'ativo' : '' %>"
        >
            <span>Pedidos</span>
        </a>

        <a
            href="/admin/vendas"
            class="<%= secaoAdmin === 'vendas' ? 'ativo' : '' %>"
        >
            <span>Vendas</span>
        </a>

    </nav>

</aside>
