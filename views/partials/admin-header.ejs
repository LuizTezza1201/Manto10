<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Painel administrativo da Manto 10."
    >

    <title><%= titulo %> | Manto 10</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/admin-pedidos.css">
    <link rel="stylesheet" href="/css/admin-vendas.css">
</head>

<body class="admin-body">

    <!-- =====================================================
         CABEÇALHO EXCLUSIVO DO PAINEL ADMINISTRATIVO
    ====================================================== -->
    <header class="admin-cabecalho">

        <button
            type="button"
            class="admin-menu-mobile"
            id="adminMenuMobile"
            aria-label="Abrir menu administrativo"
            aria-controls="adminSidebar"
            aria-expanded="false"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <% if (typeof caminhoAtual !== 'undefined' && caminhoAtual !== '/admin') { %>

            <button
                type="button"
                class="admin-voltar-botao"
                onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/admin'; }"
            >
                ← Voltar
            </button>

        <% } %>

        <div class="admin-cabecalho-identidade">
            <strong>Painel administrativo</strong>

            <% if (usuario) { %>
                <span>
                    Olá, <%= usuario.nome.split(' ')[0] %>
                </span>
            <% } %>
        </div>

        <div class="admin-cabecalho-acoes">
            <a
                href="/"
                class="admin-cabecalho-botao admin-cabecalho-botao-loja"
            >
                Ir à loja
            </a>

            <form
                action="/logout"
                method="POST"
                class="admin-cabecalho-form"
            >
                <button
                    type="submit"
                    class="admin-cabecalho-botao admin-cabecalho-botao-sair"
                >
                    Sair
                </button>
            </form>
        </div>

    </header>

    <button
        type="button"
        class="admin-sidebar-overlay"
        id="adminSidebarOverlay"
        aria-label="Fechar menu administrativo"
        tabindex="-1"
    ></button>
