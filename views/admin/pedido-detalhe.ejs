<%- include('../partials/admin-header') %>

<%
    const transicoesStatus = {

        Pendente: [
            'Pendente',
            'Pago'
        ],

        Pago: [
            'Pago',
            'Preparando'
        ],

        Preparando: [
            'Preparando',
            'Enviado'
        ],

        Enviado: [
            'Enviado',
            'Entregue'
        ],

        Entregue: [
            'Entregue'
        ],

        Cancelado: []
    };

    const statusDisponiveis =
        transicoesStatus[pedido.status] || [];

    const podeRastrear = [
        'Pago',
        'Preparando',
        'Enviado',
        'Entregue'
    ].includes(pedido.status);
%>


<div class="admin-layout">

    <%- include('../partials/admin-sidebar', {
        secaoAdmin: 'pedidos'
    }) %>


    <main class="admin-pagina admin-conteudo">

        <div class="admin-container">


            <!-- ==========================================
                 TOPO
            =========================================== -->

            <div class="admin-topo">

                <div>

                    <span class="admin-etiqueta">
                        PEDIDO
                    </span>

                    <h1>
                        #<%= pedido.numero_pedido %>
                    </h1>

                    <p>
                        Criado em
                        <%= pedido.criado_em_formatado %>
                    </p>

                </div>


                <a
                    href="/admin/pedidos"
                    class="admin-botao-secundario"
                >
                    Voltar aos pedidos
                </a>

            </div>


            <!-- ==========================================
                 MENSAGENS
            =========================================== -->

            <% if (sucesso === 'status') { %>

                <div class="admin-alerta-sucesso">

                    Status do pedido atualizado
                    com sucesso.

                </div>

            <% } %>


            <% if (sucesso === 'cancelamento') { %>

                <div class="admin-alerta-sucesso">

                    Pedido cancelado e estoque
                    restituído com sucesso.

                </div>

            <% } %>


            <% if (sucesso === 'rastreio') { %>

                <div class="admin-alerta-sucesso">

                    Código de rastreio salvo
                    com sucesso.

                </div>

            <% } %>


            <% if (erro) { %>

                <div class="admin-alerta-erro">
                    <%= erro %>
                </div>

            <% } %>


            <!-- ==========================================
                 RESUMO
            =========================================== -->

            <section class="pedido-detalhe-grid">


                <!-- CLIENTE -->

                <article class="pedido-detalhe-card">

                    <span class="pedido-detalhe-titulo">
                        Cliente
                    </span>

                    <strong>
                        <%= pedido.cliente_nome %>
                    </strong>

                    <p>
                        <%= pedido.cliente_email %>
                    </p>

                </article>


                <!-- STATUS -->

                <article class="pedido-detalhe-card">

                    <span class="pedido-detalhe-titulo">
                        Status do pedido
                    </span>

                    <strong>
                        <%= pedido.status %>
                    </strong>

                    <p>
                        Atualizado em
                        <%= pedido.atualizado_em_formatado %>
                    </p>

                </article>


                <!-- PAGAMENTO -->

                <article class="pedido-detalhe-card">

                    <span class="pedido-detalhe-titulo">
                        Pagamento
                    </span>


                    <% if (pedido.forma_pagamento) { %>

                        <strong>
                            <%= pedido.forma_pagamento %>
                        </strong>

                        <p>
                            <%= pedido.pagamento_status %>
                        </p>

                    <% } else { %>

                        <strong>
                            Não informado
                        </strong>

                        <p>
                            Nenhum pagamento registrado.
                        </p>

                    <% } %>

                </article>


                <!-- ESTOQUE -->

                <article class="pedido-detalhe-card">

                    <span class="pedido-detalhe-titulo">
                        Estoque
                    </span>


                    <% if (pedido.estoque_restituido) { %>

                        <strong>
                            Restituído
                        </strong>

                        <p>
                            As unidades voltaram
                            ao estoque.
                        </p>

                    <% } else { %>

                        <strong>
                            Reservado
                        </strong>

                        <p>
                            As unidades permanecem
                            vinculadas ao pedido.
                        </p>

                    <% } %>

                </article>

            </section>


            <!-- ==========================================
                 CONTEÚDO
            =========================================== -->

            <div class="pedido-detalhe-layout">


                <!-- ======================================
                     COLUNA PRINCIPAL
                ======================================= -->

                <div>


                    <!-- ITENS -->

                    <section class="pedido-bloco">

                        <div class="pedido-bloco-cabecalho">

                            <h2>
                                Produtos
                            </h2>

                            <span>
                                <%= itens.length %>
                                item(ns)
                            </span>

                        </div>


                        <% if (itens.length > 0) { %>

                            <div class="pedido-itens">

                                <% itens.forEach((item) => { %>

                                    <article class="pedido-item">

                                        <div class="pedido-item-imagem">

                                            <img
                                                src="<%= item.imagem || '/images/produtos/placeholder.svg' %>"
                                                alt="<%= item.nome_produto %>"
                                                onerror="this.onerror=null;this.src='/images/produtos/placeholder.svg';"
                                            >

                                        </div>


                                        <div class="pedido-item-dados">

                                            <span>
                                                <%= item.codigo_produto %>
                                            </span>

                                            <h3>
                                                <%= item.nome_produto %>
                                            </h3>

                                            <p>
                                                Tamanho:

                                                <strong>
                                                    <%= item.tamanho %>
                                                </strong>
                                            </p>

                                            <% if (item.preferencia_box) { %>
                                                <p>
                                                    Preferência:
                                                    <strong>
                                                        <%= item.preferencia_box %>
                                                    </strong>
                                                </p>
                                            <% } %>

                                        </div>


                                        <div class="pedido-item-quantidade">

                                            <span>
                                                Quantidade
                                            </span>

                                            <strong>
                                                <%= item.quantidade %>
                                            </strong>

                                        </div>


                                        <div class="pedido-item-preco">

                                            <span>
                                                Unitário
                                            </span>

                                            <strong>
                                                <%= item.preco_unitario_formatado %>
                                            </strong>

                                        </div>


                                        <div class="pedido-item-subtotal">

                                            <span>
                                                Subtotal
                                            </span>

                                            <strong>
                                                <%= item.subtotal_formatado %>
                                            </strong>

                                        </div>

                                    </article>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <p class="pedido-texto-vazio">
                                Nenhum item registrado.
                            </p>

                        <% } %>

                    </section>


                    <!-- ENDEREÇO -->

                    <section class="pedido-bloco">

                        <div class="pedido-bloco-cabecalho">

                            <h2>
                                Endereço de entrega
                            </h2>

                        </div>


                        <div class="pedido-endereco">

                            <p>

                                <strong>
                                    <%= pedido.logradouro %>,
                                    <%= pedido.endereco_numero %>
                                </strong>

                            </p>


                            <% if (pedido.complemento) { %>

                                <p>
                                    <%= pedido.complemento %>
                                </p>

                            <% } %>


                            <p>
                                <%= pedido.bairro %>
                            </p>


                            <p>
                                <%= pedido.cidade %>
                                -
                                <%= pedido.estado %>
                            </p>


                            <p>
                                CEP:
                                <%= pedido.cep %>
                            </p>

                        </div>

                    </section>


                    <!-- OBSERVAÇÃO -->

                    <% if (pedido.observacao) { %>

                        <section class="pedido-bloco">

                            <div class="pedido-bloco-cabecalho">

                                <h2>
                                    Observação
                                </h2>

                            </div>

                            <p class="pedido-observacao">
                                <%= pedido.observacao %>
                            </p>

                        </section>

                    <% } %>


                    <!-- CANCELAMENTO -->

                    <% if (
                        !pedido.estoque_restituido &&
                        (
                            pedido.status === 'Pendente' ||
                            pedido.status === 'Cancelado'
                        )
                    ) { %>

                        <section
                            class="
                                pedido-bloco
                                pedido-bloco-cancelamento
                            "
                        >

                            <div class="pedido-bloco-cabecalho">

                                <h2>
                                    Cancelamento
                                </h2>

                            </div>


                            <% if (pedido.status === 'Pendente') { %>

                                <p class="pedido-cancelamento-texto">

                                    Cancela o pedido e devolve
                                    todas as unidades ao estoque.

                                </p>

                            <% } else { %>

                                <p class="pedido-cancelamento-texto">

                                    Este pedido já está cancelado,
                                    mas o estoque ainda não foi
                                    restituído.

                                </p>

                            <% } %>


                            <form
                                action="/admin/pedidos/<%= pedido.id %>/cancelar"
                                method="POST"

                                onsubmit="return confirm('Confirma o cancelamento e a restituição do estoque?');"
                            >

                                <button
                                    type="submit"
                                    class="pedido-cancelar-botao"
                                >

                                    <%= pedido.status === 'Pendente'
                                        ? 'Cancelar e restituir estoque'
                                        : 'Restituir estoque'
                                    %>

                                </button>

                            </form>

                        </section>

                    <% } %>

                </div>


                <!-- ======================================
                     LATERAL
                ======================================= -->

                <aside class="pedido-lateral">


                    <!-- RESUMO -->

                    <section class="pedido-bloco">

                        <div class="pedido-bloco-cabecalho">

                            <h2>
                                Resumo
                            </h2>

                        </div>


                        <div class="pedido-valores">

                            <div>

                                <span>
                                    Subtotal
                                </span>

                                <strong>
                                    <%= pedido.subtotal_formatado %>
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Frete
                                </span>

                                <strong>
                                    <%= pedido.frete_formatado %>
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Desconto
                                </span>

                                <strong>
                                    - <%= pedido.desconto_formatado %>
                                </strong>

                            </div>


                            <% if (pedido.cupom_codigo) { %>

                                <div>

                                    <span>
                                        Cupom
                                    </span>

                                    <strong>
                                        <%= pedido.cupom_codigo %>
                                    </strong>

                                </div>

                            <% } %>


                            <div class="pedido-valor-total">

                                <span>
                                    Total
                                </span>

                                <strong>
                                    <%= pedido.total_formatado %>
                                </strong>

                            </div>

                        </div>

                    </section>


                    <!-- ==================================
                         PRÓXIMA ETAPA
                    =================================== -->

                    <section class="pedido-bloco">

                        <div class="pedido-bloco-cabecalho">

                            <h2>
                                Próxima etapa
                            </h2>

                        </div>


                        <% if (pedido.status === 'Pendente') { %>

                            <div class="pedido-fluxo-info">

                                <strong>
                                    Aguardando pagamento
                                </strong>

                                <p>
                                    O pedido seguirá para
                                    separação após a confirmação
                                    do pagamento.
                                </p>

                            </div>

                        <% } %>


                        <% if (pedido.status === 'Pago') { %>

                            <div class="pedido-fluxo-info">

                                <strong>
                                    Pagamento confirmado
                                </strong>

                                <p>
                                    O pedido já pode começar
                                    a ser separado.
                                </p>

                            </div>


                            <form
                                action="/admin/pedidos/<%= pedido.id %>/status"
                                method="POST"
                            >

                                <input
                                    type="hidden"
                                    name="status"
                                    value="Preparando"
                                >

                                <button
                                    type="submit"
                                    class="pedido-acao-principal"
                                >
                                    Iniciar preparação
                                </button>

                            </form>

                        <% } %>


                        <% if (pedido.status === 'Preparando') { %>

                            <div class="pedido-fluxo-info">

                                <strong>
                                    Pedido em preparação
                                </strong>

                                <% if (pedido.codigo_rastreio) { %>

                                    <p>
                                        O rastreio já foi informado.
                                        O pedido pode ser marcado
                                        como enviado.
                                    </p>

                                <% } else { %>

                                    <p>
                                        Informe o código de rastreio
                                        antes de marcar o pedido
                                        como enviado.
                                    </p>

                                <% } %>

                            </div>


                            <% if (pedido.codigo_rastreio) { %>

                                <form
                                    action="/admin/pedidos/<%= pedido.id %>/status"
                                    method="POST"
                                >

                                    <input
                                        type="hidden"
                                        name="status"
                                        value="Enviado"
                                    >

                                    <button
                                        type="submit"
                                        class="pedido-acao-principal"
                                    >
                                        Marcar como enviado
                                    </button>

                                </form>

                            <% } %>

                        <% } %>


                        <% if (pedido.status === 'Enviado') { %>

                            <div class="pedido-fluxo-info">

                                <strong>
                                    Pedido enviado
                                </strong>

                                <p>
                                    Quando o cliente receber
                                    a compra, finalize o pedido.
                                </p>

                            </div>


                            <form
                                action="/admin/pedidos/<%= pedido.id %>/status"
                                method="POST"
                            >

                                <input
                                    type="hidden"
                                    name="status"
                                    value="Entregue"
                                >

                                <button
                                    type="submit"
                                    class="pedido-acao-principal"
                                >
                                    Marcar como entregue
                                </button>

                            </form>

                        <% } %>


                        <% if (pedido.status === 'Entregue') { %>

                            <div class="pedido-fluxo-info">

                                <strong>
                                    Pedido concluído
                                </strong>

                                <p>
                                    Este pedido já foi marcado
                                    como entregue.
                                </p>

                            </div>

                        <% } %>


                        <% if (pedido.status === 'Cancelado') { %>

                            <div class="pedido-fluxo-info">

                                <strong>
                                    Pedido cancelado
                                </strong>

                                <p>
                                    Este pedido não pode
                                    ser reativado.
                                </p>

                            </div>

                        <% } %>

                    </section>


                    <!-- ==================================
                         RASTREAMENTO
                    =================================== -->

                    <% if (podeRastrear) { %>

                        <section class="pedido-bloco">

                            <div class="pedido-bloco-cabecalho">

                                <h2>
                                    Rastreamento
                                </h2>

                            </div>


                            <% if (pedido.codigo_rastreio) { %>

                                <div class="pedido-rastreio-atual">

                                    <span>
                                        Código atual
                                    </span>

                                    <strong>
                                        <%= pedido.codigo_rastreio %>
                                    </strong>


                                    <% if (
                                        pedido.rastreio_atualizado_em_formatado
                                    ) { %>

                                        <small>

                                            Atualizado em
                                            <%= pedido.rastreio_atualizado_em_formatado %>

                                        </small>

                                    <% } %>

                                </div>

                            <% } %>


                            <form
                                action="/admin/pedidos/<%= pedido.id %>/rastreio"
                                method="POST"
                                class="pedido-rastreio-form"
                            >

                                <label for="codigoRastreio">
                                    Código de rastreio
                                </label>

                                <input
                                    type="text"
                                    id="codigoRastreio"
                                    name="codigo_rastreio"
                                    maxlength="100"
                                    value="<%= pedido.codigo_rastreio || '' %>"
                                    placeholder="Ex.: BR123456789BR"
                                    required
                                >

                                <button
                                    type="submit"
                                >
                                    <%= pedido.codigo_rastreio
                                        ? 'Atualizar rastreio'
                                        : 'Salvar rastreio'
                                    %>
                                </button>

                            </form>
</section>

                    <% } %>


                    <!-- ==================================
                         ATUALIZAÇÃO MANUAL
                    =================================== -->

                    <% if (statusDisponiveis.length > 0) { %>

                        <section class="pedido-bloco">

                            <div class="pedido-bloco-cabecalho">

                                <h2>
                                    Atualizar status
                                </h2>

                            </div>


                            <form
                                action="/admin/pedidos/<%= pedido.id %>/status"
                                method="POST"
                                class="pedido-status-form"
                            >

                                <select
                                    name="status"
                                    required
                                >

                                    <% statusDisponiveis.forEach((status) => { %>

                                        <option
                                            value="<%= status %>"

                                            <%= pedido.status === status
                                                ? 'selected'
                                                : ''
                                            %>
                                        >
                                            <%= status %>
                                        </option>

                                    <% }) %>

                                </select>


                                <button type="submit">
                                    Atualizar status
                                </button>

                            </form>

                        </section>

                    <% } %>

                </aside>

            </div>

        </div>

    </main>

</div>

<%- include('../partials/admin-footer') %>