<%- include('../partials/admin-header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar', {
        secaoAdmin: 'produtos'
    }) %>

    <main class="admin-pagina admin-conteudo">

    <div class="admin-container">

        <div class="admin-topo">

            <div>

                <span class="admin-etiqueta">
                    ADMINISTRADOR
                </span>

                <h1>
                    Editar camisa
                </h1>

                <p>
                    Atualize as informações do produto.
                </p>

            </div>

            <a
                href="/admin/produtos"
                class="admin-botao-secundario"
            >
                Voltar para camisas
            </a>

        </div>

        <% if (sucesso) { %>

            <div class="admin-alerta-sucesso">
                Camisa atualizada com sucesso.
            </div>

        <% } %>

        <% if (erro) { %>

            <div class="admin-alerta-erro">
                <%= erro %>
            </div>

        <% } %>

        <section class="admin-editar-produto admin-cadastro-produto">
            <aside class="admin-editar-imagem">

                <div class="admin-editar-imagem-box">

                    <img
                        src="<%= produto.imagem || '/images/produtos/placeholder.svg' %>"
                        alt="<%= produto.nome %>"
                        onerror="this.onerror=null;this.src='/images/produtos/placeholder.svg';"
                    >

                </div>

                <span
                    class="admin-status <%= produto.status === 'Ativo'
                        ? 'ativo'
                        : 'inativo'
                    %>"
                >
                    <%= produto.status %>
                </span>

                <p>
                    Você pode substituir a foto atual
                    selecionando uma nova imagem no formulário.
                </p>

            </aside>

            <form
                action="/admin/produtos/<%= produto.id %>/editar"
                method="POST"
                enctype="multipart/form-data"
                class="admin-form-produto"
            >

                <div class="admin-form-grid">

                    <label>

                        <span>
                            Código
                        </span>

                        <input
                            type="text"
                            name="codigo"
                            maxlength="50"
                            value="<%= produto.codigo %>"
                            required
                        >

                    </label>

                    <label>

                        <span>
                            Tipo da camisa
                        </span>

                        <select
                            name="tipo_camisa"
                            required
                        >

                            <option
                                value="Tailandesa"
                                <%= produto.tipo_camisa === 'Tailandesa'
                                    ? 'selected'
                                    : ''
                                %>
                            >
                                Tailandesa
                            </option>

                            <option
                                value="Nacional Premium"
                                <%= produto.tipo_camisa === 'Nacional Premium'
                                    ? 'selected'
                                    : ''
                                %>
                            >
                                Nacional Premium
                            </option>

                        </select>

                    </label>

                    <label class="admin-form-campo-largo">

                        <span>
                            Nome
                        </span>

                        <input
                            type="text"
                            name="nome"
                            maxlength="180"
                            value="<%= produto.nome %>"
                            required
                        >

                    </label>

                    <label>

                        <span>
                            Categoria
                        </span>

                        <select
                            name="categoria_id"
                            id="categoriaEdicaoProduto"
                            required
                        >

                            <% categorias.forEach((categoria) => { %>

                                <option
                                    value="<%= categoria.id %>"
                                    data-slug="<%= categoria.slug %>"
                                    <%= Number(produto.categoria_id) === Number(categoria.id)
                                        ? 'selected'
                                        : ''
                                    %>
                                >
                                    <%= categoria.nome %>
                                    <%= categoria.status === 'Inativo'
                                        ? ' - Inativa'
                                        : ''
                                    %>
                                </option>

                            <% }) %>

                        </select>

                    </label>

                    <label>

                        <span>
                            Liga
                        </span>

                        <select
                            name="liga_id"
                            id="ligaEdicaoProduto"
                            required
                        >

                            <option value="">
                                Não se aplica
                            </option>

                            <% ligas.forEach((liga) => { %>

                                <option
                                    value="<%= liga.id %>"
                                    <%= Number(produto.liga_id) === Number(liga.id)
                                        ? 'selected'
                                        : ''
                                    %>
                                >
                                    <%= liga.nome %>
                                    <%= liga.status === 'Inativo'
                                        ? ' - Inativa'
                                        : ''
                                    %>
                                </option>

                            <% }) %>

                        </select>

                    </label>

                    <label>

                        <span>
                            Temporada
                        </span>

                        <input
                            type="text"
                            name="temporada"
                            maxlength="30"
                            value="<%= produto.temporada || '' %>"
                            placeholder="Ex.: 2025/26"
                        >

                    </label>

                    <label>

                        <span>
                            Preço original
                        </span>

                        <input
                            type="number"
                            name="preco"
                            min="0.01"
                            step="0.01"
                            value="<%= Number(produto.preco).toFixed(2) %>"
                            required
                        >

                    </label>

                    <label>

                        <span>
                            Preço promocional
                        </span>

                        <input
                            type="number"
                            name="preco_promocional"
                            min="0"
                            step="0.01"
                            value="<%= produto.preco_promocional !== null
                                ? Number(produto.preco_promocional).toFixed(2)
                                : ''
                            %>"
                        >

                    </label>

                    <label>

                        <span>
                            Desconto Pix (%)
                        </span>

                        <input
                            type="number"
                            name="desconto_pix"
                            min="0"
                            max="100"
                            step="0.01"
                            value="<%= Number(produto.desconto_pix || 0).toFixed(2) %>"
                        >

                    </label>

                    <div class="admin-form-campo admin-form-campo-largo">

                        <span class="admin-form-label">
                            Alterar foto frontal
                        </span>

                        <div class="admin-upload">
                            <input
                                type="file"
                                name="imagem"
                                id="imagemProdutoEditar"
                                class="admin-upload-input"
                                accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                data-upload-input
                            >

                            <label
                                for="imagemProdutoEditar"
                                class="admin-upload-botao"
                            >
                                Escolher imagem
                            </label>

                            <span
                                class="admin-upload-nome"
                                data-upload-nome
                            >
                                Nenhuma imagem selecionada
                            </span>
                        </div>

                        <small>
                            Deixe sem selecionar para manter a foto atual.
                            JPG, PNG ou WEBP. Máximo de 5 MB.
                        </small>

                    </div>

                    <label class="admin-form-campo-largo">

                        <span>
                            Descrição
                        </span>

                        <textarea
                            name="descricao"
                            rows="6"
                            placeholder="Descrição da camisa..."
                        ><%= produto.descricao || '' %></textarea>

                    </label>

                </div>

                <div class="admin-form-opcoes">

                    <label>

                        <input
                            type="checkbox"
                            name="destaque"
                            value="1"
                            <%= produto.destaque
                                ? 'checked'
                                : ''
                            %>
                        >

                        <span>
                            Produto em destaque
                        </span>

                    </label>

                    <label>

                        <input
                            type="checkbox"
                            name="mais_vendido"
                            value="1"
                            <%= produto.mais_vendido
                                ? 'checked'
                                : ''
                            %>
                        >

                        <span>
                            Marcar como mais vendido
                        </span>

                    </label>

                </div>

                <div class="admin-form-acoes">

                    <a
                        href="/admin/produtos"
                        class="admin-form-cancelar"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="admin-form-salvar"
                    >
                        Salvar alterações
                    </button>

                </div>

            </form>

        </section>

    </div>

    </main>

</div>

<script>

document.addEventListener(
    'DOMContentLoaded',
    () => {
        const categoria =
            document.getElementById(
                'categoriaEdicaoProduto'
            );

        const liga =
            document.getElementById(
                'ligaEdicaoProduto'
            );

        if (!categoria || !liga) {
            return;
        }

        function atualizarLiga() {
            const opcao =
                categoria.options[
                    categoria.selectedIndex
                ];

            const ehBox =
                opcao &&
                opcao.dataset.slug ===
                    'box-misteriosas';

            liga.disabled = ehBox;
            liga.required = !ehBox;

            if (ehBox) {
                liga.value = '';
            }
        }

        categoria.addEventListener(
            'change',
            atualizarLiga
        );

        atualizarLiga();
    }
);

</script>

<%- include('../partials/admin-footer') %>