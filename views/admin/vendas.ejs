<%- include('../partials/header') %>

<%
    /*
     * Separação visual das vendas do site.
     *
     * Pago       = aguardando separação
     * Preparando = sendo preparado
     * Enviado    = já despachado
     * Entregue   = finalizado
     *
     * Vendas físicas/externas continuam
     * aparecendo no histórico normalmente.
     */

    const vendasASeparar =
        vendas.filter(
            venda =>
                venda.tipo_registro === 'pedido' &&
                venda.status === 'Pago'
        );


    const vendasPreparando =
        vendas.filter(
            venda =>
                venda.tipo_registro === 'pedido' &&
                venda.status === 'Preparando'
        );


    const vendasEnviadas =
        vendas.filter(
            venda =>
                venda.tipo_registro === 'pedido' &&
                venda.status === 'Enviado'
        );


    const vendasConcluidas =
        vendas.filter(
            venda =>
                venda.tipo_registro === 'pedido' &&
                venda.status === 'Entregue'
        );


    const vendasManuais =
        vendas.filter(
            venda =>
                venda.tipo_registro === 'manual'
        );
%>


<div class="admin-layout">

    <%- include('../partials/admin-sidebar', {
        secaoAdmin: 'vendas'
    }) %>


    <main class="admin-pagina admin-conteudo">

        <div class="admin-container">


            <!-- ==========================================
                 TOPO
            =========================================== -->

            <div class="admin-topo">

                <div>

                    <span class="admin-etiqueta">
                        ADMINISTRADOR
                    </span>

                    <h1>
                        Vendas
                    </h1>

                    <p>
                        Acompanhe vendas do site,
                        preparação, envio e vendas
                        registradas manualmente.
                    </p>

                </div>


                <a
                    href="/admin/vendas/nova"
                    class="admin-botao-principal"
                >
                    Criar venda
                </a>

            </div>


            <% if (sucesso) { %>

                <div class="admin-alerta-sucesso">

                    Venda registrada com sucesso.

                </div>

            <% } %>


            <!-- ==========================================
                 RESUMO FINANCEIRO
            =========================================== -->

            <section class="vendas-resumo">

                <article class="venda-resumo-card">

                    <span>
                        Hoje
                    </span>

                    <strong>
                        <%= resumo.hoje %>
                    </strong>

                    <small>
                        Vendas realizadas hoje
                    </small>

                </article>


                <article class="venda-resumo-card">

                    <span>
                        Esta semana
                    </span>

                    <strong>
                        <%= resumo.semana %>
                    </strong>

                    <small>
                        Vendas da semana atual
                    </small>

                </article>


                <article class="venda-resumo-card">

                    <span>
                        Este mês
                    </span>

                    <strong>
                        <%= resumo.mes %>
                    </strong>

                    <small>
                        Vendas do mês atual
                    </small>

                </article>


                <article class="venda-resumo-card">

                    <span>
                        Este ano
                    </span>

                    <strong>
                        <%= resumo.ano %>
                    </strong>

                    <small>
                        Vendas do ano atual
                    </small>

                </article>

            </section>


            <!-- ==========================================
                 OPERAÇÃO
            =========================================== -->

            <section class="vendas-operacao">

                <div class="vendas-operacao-topo">

                    <div>

                        <span>
                            OPERAÇÃO
                        </span>

                        <h2>
                            Pedidos vendidos pelo site
                        </h2>

                        <p>
                            Controle a separação e o envio
                            dos pedidos já pagos.
                        </p>

                    </div>

                </div>


                <div class="vendas-operacao-resumo">


                    <a
                        href="#vendas-a-separar"
                        class="vendas-operacao-card"
                    >

                        <span>
                            A separar
                        </span>

                        <strong>
                            <%= vendasASeparar.length %>
                        </strong>

                        <small>
                            Pagamento confirmado
                        </small>

                    </a>


                    <a
                        href="#vendas-preparando"
                        class="vendas-operacao-card"
                    >

                        <span>
                            Preparando
                        </span>

                        <strong>
                            <%= vendasPreparando.length %>
                        </strong>

                        <small>
                            Em separação
                        </small>

                    </a>


                    <a
                        href="#vendas-enviadas"
                        class="vendas-operacao-card"
                    >

                        <span>
                            Enviadas
                        </span>

                        <strong>
                            <%= vendasEnviadas.length %>
                        </strong>

                        <small>
                            Aguardando entrega
                        </small>

                    </a>


                    <a
                        href="#vendas-concluidas"
                        class="vendas-operacao-card"
                    >

                        <span>
                            Entregues
                        </span>

                        <strong>
                            <%= vendasConcluidas.length %>
                        </strong>

                        <small>
                            Pedidos finalizados
                        </small>

                    </a>

                </div>

            </section>


            <!-- ==========================================
                 FUNÇÃO PARA CARD
            =========================================== -->

            <%
                function renderVendaSite(venda) {
            %>

                <article class="venda-item">

                    <div class="venda-numero">

                        <span>
                            Pedido
                        </span>

                        <strong>
                            #<%= venda.numero_pedido %>
                        </strong>

                    </div>


                    <div class="venda-cliente">

                        <span>
                            Cliente
                        </span>

                        <strong>
                            <%= venda.cliente_nome %>
                        </strong>

                        <% if (venda.cliente_email) { %>

                            <small>
                                <%= venda.cliente_email %>
                            </small>

                        <% } %>

                    </div>


                    <div>

                        <span>
                            Itens
                        </span>

                        <strong>
                            <%= venda.total_itens %>
                        </strong>

                    </div>


                    <div>

                        <span>
                            Data
                        </span>

                        <strong>
                            <%= venda.data_formatada %>
                        </strong>

                    </div>


                    <div>

                        <span>
                            Status
                        </span>

                        <strong class="venda-status">
                            <%= venda.status %>
                        </strong>

                    </div>


                    <div class="venda-valor">

                        <span>
                            Total
                        </span>

                        <strong>
                            <%= venda.total_formatado %>
                        </strong>

                    </div>


                    <a
                        href="/admin/pedidos/<%= venda.id %>"
                        class="venda-detalhes"
                    >
                        Ver detalhes
                    </a>

                </article>

            <%
                }
            %>


            <!-- ==========================================
                 A SEPARAR
            =========================================== -->

            <section
                class="vendas-bloco"
                id="vendas-a-separar"
            >

                <div class="vendas-bloco-topo">

                    <div>

                        <span>
                            AÇÃO NECESSÁRIA
                        </span>

                        <h2>
                            Aguardando separação
                        </h2>

                    </div>

                    <strong class="vendas-contador-status">
                        <%= vendasASeparar.length %>
                    </strong>

                </div>


                <% if (vendasASeparar.length > 0) { %>

                    <div class="vendas-lista">

                        <% vendasASeparar.forEach((venda) => { %>

                            <% renderVendaSite(venda); %>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="vendas-status-vazio">

                        Nenhum pedido aguardando separação.

                    </div>

                <% } %>

            </section>


            <!-- ==========================================
                 PREPARANDO
            =========================================== -->

            <section
                class="vendas-bloco"
                id="vendas-preparando"
            >

                <div class="vendas-bloco-topo">

                    <div>

                        <span>
                            EM ANDAMENTO
                        </span>

                        <h2>
                            Preparando
                        </h2>

                    </div>

                    <strong class="vendas-contador-status">
                        <%= vendasPreparando.length %>
                    </strong>

                </div>


                <% if (vendasPreparando.length > 0) { %>

                    <div class="vendas-lista">

                        <% vendasPreparando.forEach((venda) => { %>

                            <% renderVendaSite(venda); %>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="vendas-status-vazio">

                        Nenhum pedido em preparação.

                    </div>

                <% } %>

            </section>


            <!-- ==========================================
                 ENVIADAS
            =========================================== -->

            <section
                class="vendas-bloco"
                id="vendas-enviadas"
            >

                <div class="vendas-bloco-topo">

                    <div>

                        <span>
                            ENVIO
                        </span>

                        <h2>
                            Enviadas
                        </h2>

                    </div>

                    <strong class="vendas-contador-status">
                        <%= vendasEnviadas.length %>
                    </strong>

                </div>


                <% if (vendasEnviadas.length > 0) { %>

                    <div class="vendas-lista">

                        <% vendasEnviadas.forEach((venda) => { %>

                            <% renderVendaSite(venda); %>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="vendas-status-vazio">

                        Nenhum pedido enviado.

                    </div>

                <% } %>

            </section>


            <!-- ==========================================
                 VENDAS MANUAIS
            =========================================== -->

            <section class="vendas-bloco">

                <div class="vendas-bloco-topo">

                    <div>

                        <span>
                            LOJA / EXTERNO
                        </span>

                        <h2>
                            Vendas manuais
                        </h2>

                    </div>

                    <strong class="vendas-contador-status">
                        <%= vendasManuais.length %>
                    </strong>

                </div>


                <% if (vendasManuais.length > 0) { %>

                    <div class="vendas-lista">

                        <% vendasManuais.forEach((venda) => { %>

                            <article class="venda-item">

                                <div class="venda-numero">

                                    <span>
                                        Venda
                                    </span>

                                    <strong>
                                        #<%= venda.numero_pedido %>
                                    </strong>

                                </div>


                                <div class="venda-cliente">

                                    <span>
                                        Cliente
                                    </span>

                                    <strong>
                                        <%= venda.cliente_nome %>
                                    </strong>

                                    <small>
                                        <%= venda.origem %>
                                    </small>

                                </div>


                                <div>

                                    <span>
                                        Itens
                                    </span>

                                    <strong>
                                        <%= venda.total_itens %>
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Data
                                    </span>

                                    <strong>
                                        <%= venda.data_formatada %>
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Status
                                    </span>

                                    <strong class="venda-status">
                                        <%= venda.status %>
                                    </strong>

                                </div>


                                <div class="venda-valor">

                                    <span>
                                        Total
                                    </span>

                                    <strong>
                                        <%= venda.total_formatado %>
                                    </strong>

                                </div>


                                <a
                                    href="/admin/vendas/manuais/<%= venda.id %>"
                                    class="venda-detalhes"
                                >
                                    Ver detalhes
                                </a>

                            </article>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="vendas-status-vazio">

                        Nenhuma venda manual registrada.

                    </div>

                <% } %>

            </section>


            <!-- ==========================================
                 ENTREGUES
            =========================================== -->

            <section
                class="vendas-bloco"
                id="vendas-concluidas"
            >

                <div class="vendas-bloco-topo">

                    <div>

                        <span>
                            HISTÓRICO
                        </span>

                        <h2>
                            Pedidos entregues
                        </h2>

                    </div>

                    <strong class="vendas-contador-status">
                        <%= vendasConcluidas.length %>
                    </strong>

                </div>


                <% if (vendasConcluidas.length > 0) { %>

                    <div class="vendas-lista">

                        <% vendasConcluidas.forEach((venda) => { %>

                            <% renderVendaSite(venda); %>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="vendas-status-vazio">

                        Nenhum pedido entregue.

                    </div>

                <% } %>

            </section>

        </div>

    </main>

</div>

<%- include('../partials/footer') %>