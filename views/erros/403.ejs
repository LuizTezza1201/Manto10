    >

    <title>
        <%= titulo %>
    </title>

    <link
        rel="stylesheet"
        href="/css/erro-403.css"
    >
</head>

<body>

    <main class="erro-403">

        <div class="erro-403-conteudo">

            <p class="erro-403-codigo">
                ERRO 403
            </p>

            <h1>
                PAH! ACESSO NEGADO.
            </h1>

            <img
