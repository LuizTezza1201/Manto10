<%- include('../partials/header') %>

<main class="pagina-auth">

    <section class="cartao-auth">

        <div class="cabecalho-auth">
            <img
                src="/images/logotransparente.png"
                alt="Manto 10"
                class="logo-auth"
            >

            <h1>
                Criar conta
            </h1>

            <p>
                Cadastre-se para comprar seus mantos favoritos.
            </p>

        </div>


        <% if (erro) { %>

            <div class="mensagem-auth erro">
                <%= erro %>
            </div>

        <% } %>


        <form
            action="/cadastro"
            method="POST"
            class="formulario-auth"
        >

            <!-- NOME -->

            <div class="campo-auth">

                <label for="nome">
                    Nome completo
                </label>

                <input
                    type="text"
                    id="nome"
                    name="nome"
                    value="<%= dados.nome %>"
                    placeholder="Digite seu nome completo"
                    maxlength="150"
                    autocomplete="name"
                    required
                >

            </div>


            <!-- E-MAIL -->

            <div class="campo-auth">

                <label for="email">
                    E-mail
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    value="<%= dados.email %>"
                    placeholder="Digite seu e-mail"
                    maxlength="190"
                    autocomplete="email"
                    required
                >

            </div>


            <!-- TELEFONE -->

            <div class="campo-auth">

                <label for="telefone">
                    Celular / WhatsApp
                </label>

                <input
                    type="tel"
                    id="telefone"
                    name="telefone"
                    value="<%= dados.telefone || '' %>"
                    placeholder="(45) 99999-9999"
                    maxlength="15"
                    inputmode="tel"
                    autocomplete="tel"
                    required
                >

                <small>
                    Informe um celular com DDD.
                </small>

            </div>


            <!-- SENHA -->

            <div class="campo-auth">

                <label for="senha">
                    Senha
                </label>

                <input
                    type="password"
                    id="senha"
                    name="senha"
                    placeholder="Digite sua senha"
                    minlength="6"
                    autocomplete="new-password"
                    required
                >

                <small>
                    Utilize pelo menos 6 caracteres.
                </small>

            </div>


            <button
                type="submit"
                class="botao-auth"
            >
                Criar conta
            </button>

        </form>


        <div class="rodape-auth">

            <span>
                Já possui uma conta?
            </span>

            <a href="/login">
                Já sou cadastrado
            </a>

        </div>

    </section>

</main>


<script>
    const campoTelefone =
        document.getElementById(
            'telefone'
        );


    if (campoTelefone) {

        campoTelefone.addEventListener(
            'input',
            function () {

                let numeros =
                    this.value
                        .replace(
                            /\D/g,
                            ''
                        );


                /*
                 * Se o usuário colar
                 * +55 45 99999-9999,
                 * removemos o 55.
                 */

                if (
                    numeros.startsWith('55') &&
                    numeros.length > 11
                ) {

                    numeros =
                        numeros.slice(2);
                }


                numeros =
                    numeros.slice(
                        0,
                        11
                    );


                if (
                    numeros.length <= 2
                ) {

                    this.value =
                        numeros;

                    return;
                }


                if (
                    numeros.length <= 7
                ) {

                    this.value =
                        `(${numeros.slice(0, 2)}) ${numeros.slice(2)}`;

                    return;
                }


                this.value =
                    `(${numeros.slice(0, 2)}) ${numeros.slice(2, 7)}-${numeros.slice(7)}`;
            }
        );
    }
</script>


<%- include('../partials/footer') %>