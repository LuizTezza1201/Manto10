<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Manto 10 - Acesso à conta do cliente."
    >

    <meta
        name="theme-color"
        content="#9d00de"
    >

    <title><%= titulo %> | Manto 10</title>

    <!-- FAVICON MANTO 10 -->
    <link
        rel="icon"
        type="image/png"
        href="/images/logoroxa.png"
    >

    <link
        rel="shortcut icon"
        type="image/png"
        href="/images/logoroxa.png"
    >

    <link
        rel="apple-touch-icon"
        href="/images/logoroxa.png"
    >

    <!--
        As páginas de autenticação possuem um layout próprio.
        Não carregamos o cabeçalho, o rodapé, o carrinho lateral
        nem o botão flutuante do WhatsApp da loja.
    -->
    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/acessibilidade.css"
    >

    <link
        rel="stylesheet"
        href="/css/auth.css"
    >
</head>

<body class="pagina-auth-body">

    <main class="pagina-auth">

        <section class="cartao-auth">

            <div class="cabecalho-auth">

                <img
                    src="/images/logotransparente.png"
                    alt="Manto 10"
                    class="logo-auth"
                >

                <h1>
                    Entrar
                </h1>

                <p>
                    Acesse sua conta para continuar.
                </p>

            </div>

            <% if (sucesso) { %>

                <div class="mensagem-auth sucesso">
                    <%= sucesso %>
                </div>

            <% } %>

            <% if (erro) { %>

                <div class="mensagem-auth erro">
                    <%= erro %>
                </div>

            <% } %>

            <form
                action="/login"
                method="POST"
                class="formulario-auth"
            >

                <div class="campo-auth">

                    <label for="email">
                        E-mail
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= dados.email %>"
                        placeholder="Digite seu e-mail"
                        maxlength="190"
                        autocomplete="email"
                        required
                    >

                </div>

                <div class="campo-auth">

                    <label for="senha">
                        Senha
                    </label>

                    <input
                        type="password"
                        id="senha"
                        name="senha"
                        placeholder="Digite sua senha"
                        autocomplete="current-password"
                        required
                    >

                </div>

                <button
                    type="submit"
                    class="botao-auth"
                >
                    Entrar
                </button>

            </form>

            <div class="rodape-auth">

                <span>
                    Ainda não possui conta?
                </span>

                <a href="/cadastro">
                    Criar conta
                </a>

            </div>

        </section>

    </main>

    <%- include('../partials/acessibilidade') %>

    <script src="/js/acessibilidade.js"></script>

</body>

</html>